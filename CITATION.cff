  - type: data
    title: "NPI/NPPES Cumulative Collection (preliminary)"
    authors:
      - name: "National Bureau of Economic Research"
    url: https://www.nber.org/research/data/npinppes-cumulative-collection-preliminary
  - type: data
    title: "Medicare Fee-For-Service Public Provider Enrollment"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: https://data.cms.gov/provider-characteristics/medicare-provider-supplier-enrollment/medicare-fee-for-service-public-provider-enrollment
  - type: data
    title: "Provider of Services File"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
    url: https://data.cms.gov/provider-characteristics/hospitals-and-other-facilities/provider-of-services-file-quality-improvement-and-evaluation-system
  - type: data
    title: "Compendium of U.S. Health Systems"
    authors:
      - name: "Agency for Healthcare Research and Quality"
    url: https://www.ahrq.gov/chsp/data-resources/compendium.html
  - type: data
    title: "Medicaid Provider Spending"
    authors:
      - name: "U.S. Department of Health and Human Services"
    url: https://opendata.hhs.gov/datasets/medicaid-provider-spending
