cff-version: 1.2.0
message: "If you use this software or the data it produces, please cite it, and cite CMS NPPES and the other registries you use as the underlying sources."
type: software
title: "healthcare-ledger: dated histories of the U.S. health care provider registries and the links between them"
version: 0.1.0
date-released: 2026-10-13
license: Apache-2.0
repository-code: https://github.com/nathansutton/healthcare-ledger
authors:
  - family-names: Sutton
    given-names: Nathan
    email: nasutton@gmail.com
keywords:
  - NPPES
  - NPI
  - CMS
  - Medicare
  - PECOS
  - Provider of Services
  - health systems
  - Medicaid
  - healthcare providers
  - panel data
  - slowly changing dimension
  - DuckDB
references:
  - type: data
    title: "NPPES Data Dissemination"
    authors:
      - name: "Centers for Medicare & Medicaid Services"
